# Backend proxy — các key này chỉ lưu trên server, không lộ ra client
OPEN_WEATHER_KEY=your_openweathermap_key_here
GNEWS_KEY=your_gnews_key_here
PORT=3000

# Supabase (có thể để ở client vì anon key là public)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (có quyền bypass RLS — GIỮ BÍ MẬT, chỉ dùng server-side)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
